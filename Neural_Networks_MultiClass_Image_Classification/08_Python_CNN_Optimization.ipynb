      "source": [
        "X_train, X_val, y_train, y_val = train_test_split(df.iloc[:,1:].values, df.iloc[:,0].values, test_size = 0.4)\n",
        "X_cv, X_test, y_cv, y_test = train_test_split(X_val, y_val, test_size = 0.5)\n",
